#!/bin/bash
# ==============================================================================
# Cinema POS — GitHub private ZIP updater (Vite static + Nginx)
# Compare cinema-pos-version.json every run; download + symlink if newer.
# ==============================================================================
set -euo pipefail

GITHUB_TOKEN="{{ pos_github_token }}"
OWNER="{{ pos_github_owner }}"
REPO="{{ pos_github_repo }}"
REF="{{ pos_github_ref }}"
PATH_ZIP="{{ pos_github_path_zip }}"
PATH_VERSION="{{ pos_github_path_version }}"

BASE_DIR="{{ pos_web_root }}"
RELEASES_DIR="{{ pos_releases_dir }}"
OPT_DIR="{{ pos_opt_dir }}"

CURRENT_VERSION_FILE="{{ pos_local_version_file }}"
NEW_VERSION_FILE="{{ pos_new_version_file }}"

TEMP_DIR="/tmp/cinema_pos_deploy"
ZIP_FILE="$TEMP_DIR/cinema-pos.zip"
LOG_FILE="{{ pos_log_dir }}/version.log"

# Files/dirs that must NOT be replaced by ZIP contents (real files under BASE_DIR)
PRESERVED_NAMES="config.json releases"

API_ACCEPT="Accept: application/vnd.github.raw+json"
API_AUTH="Authorization: Bearer ${GITHUB_TOKEN}"
API_VERSION="X-GitHub-Api-Version: 2022-11-28"

mkdir -p "{{ pos_log_dir }}" "$TEMP_DIR" "$RELEASES_DIR" "$BASE_DIR" "$OPT_DIR"

log() {
  echo "$(date '+%Y-%m-%d %H:%M:%S') [$1] $2" >> "$LOG_FILE"
}

github_download() {
  local repo_path="$1"
  local dest="$2"
  local url="https://api.github.com/repos/${OWNER}/${REPO}/contents/${repo_path}?ref=${REF}"

  if [ -z "${GITHUB_TOKEN}" ] || [ "${GITHUB_TOKEN}" = "CHANGE_ME" ]; then
    log "ERROR" "pos_github_token / vault_github_token is empty"
    return 1
  fi

  curl -fsSL \
    -H "${API_ACCEPT}" \
    -H "${API_AUTH}" \
    -H "${API_VERSION}" \
    -o "${dest}" \
    "${url}"
}

is_preserved() {
  local name="$1"
  for p in $PRESERVED_NAMES; do
    [ "$name" = "$p" ] && return 0
  done
  return 1
}

get_version() {
  if [ -f "$1" ]; then
    sed -n 's/.*"version"[[:space:]]*:[[:space:]]*\([0-9][0-9]*\).*/\1/p' "$1" | head -n1
  else
    echo "0"
  fi
}

log "INFO" "=== Cinema POS version check started ==="

if ! github_download "${PATH_VERSION}" "${NEW_VERSION_FILE}"; then
  log "ERROR" "Failed to download version JSON from GitHub"
  exit 1
fi

NEW_VERSION="$(get_version "$NEW_VERSION_FILE")"
CURRENT_VERSION="$(get_version "$CURRENT_VERSION_FILE")"
log "INFO" "Current version: ${CURRENT_VERSION} | New version: ${NEW_VERSION}"

if [ -z "${NEW_VERSION}" ]; then
  log "ERROR" "Invalid version in downloaded file"
  exit 1
fi

case "${NEW_VERSION}" in
  ''|*[!0-9]*)
    log "ERROR" "Version is not numeric: ${NEW_VERSION}"
    exit 1
    ;;
esac

if [ "${NEW_VERSION}" -eq "${CURRENT_VERSION}" ]; then
  log "INFO" "Already on version ${NEW_VERSION} — no update needed"
  exit 0
fi

log "INFO" "New version detected: ${CURRENT_VERSION} -> ${NEW_VERSION}"

if ! github_download "${PATH_ZIP}" "${ZIP_FILE}"; then
  log "ERROR" "Failed to download cinema-pos.zip from GitHub"
  exit 1
fi

RELEASE_DIR="${RELEASES_DIR}/${NEW_VERSION}"
rm -rf "${RELEASE_DIR}"
mkdir -p "${RELEASE_DIR}"

log "INFO" "Extracting build to ${RELEASE_DIR}..."
unzip -qo "${ZIP_FILE}" -d "${RELEASE_DIR}"

# If zip contains a single top-level dist/ folder, flatten it
if [ -d "${RELEASE_DIR}/dist" ] && [ ! -f "${RELEASE_DIR}/index.html" ]; then
  shopt -s dotglob
  mv "${RELEASE_DIR}/dist/"* "${RELEASE_DIR}/" 2>/dev/null || true
  rmdir "${RELEASE_DIR}/dist" 2>/dev/null || true
  shopt -u dotglob
fi

# Preserve old hashed Vite assets so open tabs without hard-refresh still work
if [ -L "${BASE_DIR}/assets" ] && [ -d "$(readlink -f "${BASE_DIR}/assets")" ]; then
  OLD_ASSETS="$(readlink -f "${BASE_DIR}/assets")"
  log "INFO" "Preserving old assets from ${OLD_ASSETS}..."
  mkdir -p "${RELEASE_DIR}/assets"
  cp -rn "${OLD_ASSETS}/." "${RELEASE_DIR}/assets/" 2>/dev/null || true
elif [ -d "${BASE_DIR}/assets" ]; then
  log "INFO" "Preserving old assets from ${BASE_DIR}/assets..."
  mkdir -p "${RELEASE_DIR}/assets"
  cp -rn "${BASE_DIR}/assets/." "${RELEASE_DIR}/assets/" 2>/dev/null || true
fi

log "INFO" "Creating symlinks for ZIP contents..."
for item in "${RELEASE_DIR}"/*; do
  [ -e "$item" ] || continue
  item_name="$(basename "$item")"
  target_path="${BASE_DIR}/${item_name}"

  if is_preserved "$item_name"; then
    log "INFO" "Skipping preserved name: ${item_name}"
    continue
  fi

  if [ -L "$target_path" ]; then
    rm -f "$target_path"
  elif [ -e "$target_path" ]; then
    rm -rf "$target_path"
  fi

  ln -s "$item" "$target_path"
  log "INFO" "Symlinked: ${item_name} -> ${RELEASE_DIR}/${item_name}"
done

# Hidden files from release (except . and ..)
shopt -s nullglob dotglob
for item in "${RELEASE_DIR}"/.*; do
  item_name="$(basename "$item")"
  [ "$item_name" = "." ] || [ "$item_name" = ".." ] && continue
  target_path="${BASE_DIR}/${item_name}"
  if [ -L "$target_path" ]; then
    rm -f "$target_path"
  elif [ -e "$target_path" ]; then
    rm -rf "$target_path"
  fi
  ln -s "$item" "$target_path"
  log "INFO" "Symlinked: ${item_name}"
done
shopt -u nullglob dotglob

cp "${NEW_VERSION_FILE}" "${CURRENT_VERSION_FILE}"

chown -R www-data:www-data "${RELEASE_DIR}" 2>/dev/null || true
chown -h www-data:www-data "${BASE_DIR}"/* 2>/dev/null || true
chown www-data:www-data "${BASE_DIR}" 2>/dev/null || true

# Reload nginx without requiring systemd (works in lab Docker)
if command -v nginx >/dev/null 2>&1; then
  if nginx -t >> "$LOG_FILE" 2>&1; then
    if systemctl reload nginx >> "$LOG_FILE" 2>&1; then
      log "INFO" "Nginx reloaded via systemctl"
    elif nginx -s reload >> "$LOG_FILE" 2>&1; then
      log "INFO" "Nginx reloaded via nginx -s reload"
    else
      log "WARN" "Nginx reload failed"
    fi
  else
    log "WARN" "nginx -t failed; skip reload"
  fi
else
  log "WARN" "nginx binary not found"
fi

log "INFO" "Cleaning up old releases (keep last {{ pos_keep_releases }})..."
ls -td "${RELEASES_DIR}"/*/ 2>/dev/null | tail -n +$(({{ pos_keep_releases }} + 1)) | xargs rm -rf 2>/dev/null || true
rm -f "${ZIP_FILE}"

log "INFO" "=== Deploy to version ${NEW_VERSION} completed ==="
exit 0
